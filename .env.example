# Karnam Vari Farms - Environment Configuration
# Copy this file to .env and configure with your Supabase project credentials.

# Supabase Project URL (from your Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Public Key (from your Supabase Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Admin demo credentials for initial testing
VITE_ADMIN_DEFAULT_EMAIL=admin@karnamvarifarms.com
VITE_ADMIN_DEFAULT_PASSWORD=KarnamAdmin2026!
