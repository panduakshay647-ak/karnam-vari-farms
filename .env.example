# Karnam Vari Farms - Environment Configuration
# Copy this file to .env and configure with your Supabase project credentials.

# Supabase Project URL (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key only. Never put the service-role key here.
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
